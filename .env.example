# Tài khoản owner của PostgreSQL trong Docker
POSTGRES_DB=dkhp
POSTGRES_USER=dkhp_app
POSTGRES_PASSWORD=change-me

# Chạy Spring Boot cục bộ
DB_URL=jdbc:postgresql://127.0.0.1:5432/dkhp
DB_USER=dkhp_api
DB_PASSWORD=CHANGE_ME
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080

# Địa chỉ và cổng bind trên máy host khi dùng Docker Compose
DB_BIND_ADDR=127.0.0.1
DB_PORT=5432
API_BIND_ADDR=127.0.0.1
API_PORT=8080

# Khóa JWT HS256, tối thiểu 32 byte ngẫu nhiên; sinh bằng: openssl rand -base64 48
JWT_SECRET=change-me-at-least-32-random-bytes

# Giới hạn của API
HEALTH_ALLOWED_IPS=127.0.0.1,::1
# Origin được gọi API từ trình duyệt, phân cách bằng dấu phẩy
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
DB_POOL_SIZE=20
RATE_LIMIT_IP=600
RATE_LIMIT_ACCOUNT=120
RATE_LIMIT_LOGIN=10
