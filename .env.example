# PostgreSQL
POSTGRES_DB=dkhp
POSTGRES_USER=dkhp_app
POSTGRES_PASSWORD=change-me

# Đặt thành IP Tailscale của máy khi API chạy.
DB_BIND_ADDR=127.0.0.1
DB_PORT=5432

# API
API_BIND_ADDR=127.0.0.1
API_PORT=8080

# Sinh khóa: openssl rand -base64 48
JWT_SECRET=change-me-at-least-32-random-bytes

# Danh sách IP được gọi /api/v1/health
HEALTH_ALLOWED_IPS=127.0.0.1
