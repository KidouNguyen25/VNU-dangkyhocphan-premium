# Tạo DB bằng tài khoản owner; API dùng tài khoản riêng có quyền tối thiểu.
DB_URL=jdbc:postgresql://127.0.0.1:5432/dkhp
DB_USER=dkhp_api
DB_PASSWORD=CHANGE_ME
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080
HEALTH_ALLOWED_IPS=127.0.0.1,::1
DB_POOL_SIZE=20
RATE_LIMIT_IP=600
RATE_LIMIT_ACCOUNT=120
RATE_LIMIT_LOGIN=10
# JWT do đồng đội cung cấp bằng bean TokenGateway, không có khóa ký trong module này.
