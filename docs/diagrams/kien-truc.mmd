flowchart LR
    subgraph TS["Mạng riêng Tailscale"]
        direction LR

        subgraph CLIENTS["Hai máy khách thử tải · 500 tài khoản giả lập mỗi máy"]
            direction TB
            SW["Trình duyệt<br/>Swagger UI do backend cung cấp"]
            K6["k6"]
        end

        subgraph APP["Máy backend · Spring Boot"]
            direction LR
            SEC["Bảo vệ API<br/>JWT, vai trò, giới hạn tốc độ,<br/>request ID, IP cho /health"]
            API["ApiController<br/>10 endpoint /api/v1<br/>kiểm tra request, tạo response"]
            DOMAIN["RegistrationService<br/>đăng nhập, đăng ký, hủy, quản trị<br/>kiểm tra giờ, ca học, tín chỉ"]
            DATA["PostgresRepository<br/>giao dịch, khóa account rồi section,<br/>idempotency, cập nhật sĩ số có điều kiện"]
        end

        subgraph DBHOST["Máy cơ sở dữ liệu"]
            PG[("PostgreSQL<br/>account, course, registration_period,<br/>section, enrollment, idempotency_record")]
        end
    end

    SW -->|HTTP qua Tailscale; Bearer JWT theo endpoint| SEC
    K6 -->|HTTP qua Tailscale; Bearer JWT| SEC
    SEC --> API --> DOMAIN --> DATA
    DATA -->|JDBC · giao dịch ngắn| PG

    NOTE["PostgreSQL là nguồn dữ liệu có thẩm quyền.<br/>Số chỗ đọc qua API chỉ để hiển thị;<br/>giao dịch quyết định cấp chỗ."]
    NOTE -.-> PG

